{
  "nodes": [
    { "id": "root", "type": "text", "x": -1300, "y": 790, "width": 260, "height": 70, "text": "## ハッカソン選び" },
    { "id": "schedule", "type": "text", "x": -950, "y": 130, "width": 260, "height": 70, "text": "**日程**", "color": "4" },
    { "id": "schedule1", "type": "text", "x": -580, "y": 20, "width": 260, "height": 70, "text": "応募期間の長さ\n今から間に合うか", "color": "4" },
    { "id": "schedule1-d1", "type": "text", "x": -200, "y": -35, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n第5回: 2026/8/20〜10/15\n**調査時点(10/11)でまだ募集中の可能性**", "color": "4" },
    { "id": "schedule1-d2", "type": "text", "x": -200, "y": 75, "width": 260, "height": 70, "text": "**B(Microsoft)**\n2026/4/7〜6/18の1回のみ確認\n次回未定、今回分は終了", "color": "4" },
    { "id": "schedule2", "type": "text", "x": -580, "y": 240, "width": 260, "height": 70, "text": "本選・発表の日程", "color": "4" },
    { "id": "schedule2-d1", "type": "text", "x": -200, "y": 185, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n最終ピッチ・表彰式は\n2026/12/1予定(第5回)", "color": "4" },
    { "id": "schedule2-d2", "type": "text", "x": -200, "y": 295, "width": 260, "height": 70, "text": "**B(Microsoft)**\n申込・提出期限6/1\n(2026年開催分、終了済み)", "color": "4" },
    { "id": "format", "type": "text", "x": -950, "y": 570, "width": 260, "height": 70, "text": "**参加形式**", "color": "6" },
    { "id": "format1", "type": "text", "x": -580, "y": 460, "width": 260, "height": 70, "text": "個人 or チーム", "color": "6" },
    { "id": "format1-d1", "type": "text", "x": -200, "y": 405, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n個人参加可能\nチーム必須ではない", "color": "6" },
    { "id": "format1-d2", "type": "text", "x": -200, "y": 515, "width": 260, "height": 70, "text": "**B(Microsoft)**\n個人部門で参加可能\n(ただしチームも個人部門に参加可)", "color": "6" },
    { "id": "format2", "type": "text", "x": -580, "y": 680, "width": 260, "height": 70, "text": "オンライン or 現地", "color": "6" },
    { "id": "format2-d1", "type": "text", "x": -200, "y": 625, "width": 260, "height": 70, "text": "**A(Google Cloud)**\nハンズオン・3都市の\nミニハッカソンあり(現地併用)", "color": "6" },
    { "id": "format2-d2", "type": "text", "x": -200, "y": 735, "width": 260, "height": 70, "text": "**B(Microsoft)**\n現地/オンラインの区分は**不明**\n(公式情報から未確認)", "color": "6" },
    { "id": "level", "type": "text", "x": -950, "y": 1010, "width": 260, "height": 70, "text": "**レベル感**", "color": "1" },
    { "id": "level1", "type": "text", "x": -580, "y": 900, "width": 260, "height": 70, "text": "登録者数\n(競争の激しさ)", "color": "1" },
    { "id": "level1-d1", "type": "text", "x": -200, "y": 845, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n第2回158件・第3回108件\n第4回195件(応募数)", "color": "1" },
    { "id": "level1-d2", "type": "text", "x": -200, "y": 955, "width": 260, "height": 70, "text": "**B(Microsoft)**\n企業+個人 合計106作品\n(Aより少ない傾向)", "color": "1" },
    { "id": "level2", "type": "text", "x": -580, "y": 1120, "width": 260, "height": 70, "text": "参加資格\n(経験年数の条件等)", "color": "1" },
    { "id": "level2-d1", "type": "text", "x": -200, "y": 1065, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n18歳以上・国内在住\n経験者限定なし、初心者歓迎明記", "color": "1" },
    { "id": "level2-d2", "type": "text", "x": -200, "y": 1175, "width": 260, "height": 70, "text": "**B(Microsoft)**\n18歳以上・企業所属不問\nスキル条件「なし」(FAQ記載)", "color": "1" },
    { "id": "theme", "type": "text", "x": -950, "y": 1450, "width": 260, "height": 70, "text": "**テーマ適性**", "color": "2" },
    { "id": "theme1", "type": "text", "x": -580, "y": 1340, "width": 260, "height": 70, "text": "得意分野と合うか", "color": "2" },
    { "id": "theme1-d1", "type": "text", "x": -200, "y": 1285, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n業務効率化〜教育・創作・生活支援まで幅広い\n自分が使う身近な課題向き", "color": "2" },
    { "id": "theme1-d2", "type": "text", "x": -200, "y": 1395, "width": 260, "height": 70, "text": "**B(Microsoft)**\n業務支援系に集中\n(製造・建設・特許・経理等)", "color": "2" },
    { "id": "theme2", "type": "text", "x": -580, "y": 1560, "width": 260, "height": 70, "text": "過去の受賞傾向", "color": "2" },
    { "id": "theme2-d1", "type": "text", "x": -200, "y": 1505, "width": 260, "height": 70, "text": "**A(Google Cloud)**\n最優秀賞のテーマは毎回変化\n(サプライチェーン→音楽教育→福祉→解剖学習)", "color": "2" },
    { "id": "theme2-d2", "type": "text", "x": -200, "y": 1615, "width": 260, "height": 70, "text": "**B(Microsoft)**\n現場の具体性・実用性が評価\n(次の行動につながる設計)", "color": "2" }
  ],
  "edges": [
